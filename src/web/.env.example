# Copy to .env (or .env.local) and fill in. Env files are git-ignored.

# Default network, "testnet" or "mainnet". Players can switch with the header toggle (saved in their browser).
VITE_HL_NETWORK=testnet

# Builder address, used on both networks. It must hold at least 100 USDC in its Hyperliquid perps account
# on each network before Hyperliquid accepts it as a builder there.
VITE_BUILDER_ADDRESS=0x0000000000000000000000000000000000000000

# Builder fee charged per fill, in tenths of a basis point. 50 = 0.05% (launch rate), 100 = 0.1% (perps cap).
VITE_BUILDER_FEE_TENTHS_BPS=50

# Max fee rate users approve once. We ask for the cap so the fee can rise later without re-approval.
VITE_BUILDER_MAX_FEE_RATE=0.1%
